APP_ENV=dev
EVENT_STORE_BACKEND=memory
EVENT_STORE_PATH=data/runtime-events.sqlite3
MODEL_PROVIDER=none
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_RETRIES=1
# JSON map of USD per 1M tokens: {"model-name": [input, output]}. Empty => cost stays null.
MODEL_PRICE_TABLE=
MCP_REMOTE_URL=
MCP_REMOTE_TOKEN=
MCP_FALLBACK_TO_LOCAL=false
# rest (legacy) or jsonrpc
MCP_PROTOCOL=rest
MCP_RETRIES=1
# Server-side bearer token; empty disables auth (local demo only)
MCP_SERVER_TOKEN=
# Allow loopback/private targets for the outbound client (local demo only)
MCP_ALLOW_INSECURE=false
MCP_REQUIRE_HTTPS=false
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8001
MULTIMODAL_HOST=127.0.0.1
MULTIMODAL_PORT=8002
# Runtime execution controls
EXECUTOR_CONCURRENCY=1
MAX_REPLANS=2
APPROVAL_TTL_SECONDS=900
# Multimodal uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=5242880
